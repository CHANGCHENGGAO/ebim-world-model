    "real": {
      "confirmed": true,
      "note": "Confirmed against the organizer-provided 28-topic MCAP reference plus the Franka ROS 2 Mobile FR3 Duo documentation. The autonomous policy publishes programmatic JointState targets to the documented GELLO-shaped arm input topics; no human GELLO/keyboard/pedal input is used.",
      "data_source": "ebim-benchmark/ebim_task2_realrobotdata (task2_munich), 7 episodes analyzed",
      "world_frame": "world",
