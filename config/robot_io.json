      },
      "onsite_bowl_cup_route": {
        "enabled": true,
        "note": "Autonomous relative-odom route. All measured motions are recorded, including the estimated 1.40 m final approach. Runtime still fails closed unless every required sensor topic is fresh. Values are relative to the odom pose when the workflow starts; they are not map coordinates.",
        "bowl_arm": "left",
        "cup_arm": "right",
        "minimum_lidar_clearance_m": 0.40,
        "narrow_nominal_side_clearance_m": 0.05,
        "narrow_minimum_side_clearance_m": 0.02,
        "narrow_center_tolerance_m": 0.02,
        "recovery_attempts": 15,
        "recovery_wait_seconds": 2.0,
        "base_settle_seconds": 3.0,
        "base_motion_calibration": {
          "source": "EBiM Task1 real robot LeRobot Part1+Part2, 50 episodes, 352655 frames at 20Hz",
          "linear_x_positive": "forward",
          "linear_y_positive": "left",
          "angular_z_positive": "counterclockwise",
          "requires_first_run_sign_confirmation": false,
          "linear_stop_latency_p95_seconds": 1.95,
          "linear_coast_p95_m": 0.069,
          "linear_coast_p99_m": 0.101
        },
        "start_to_kitchen": [
          {"name": "leave_start", "axis": "forward", "distance": 0.85, "speed": 0.10},
          {"name": "face_kitchen_door", "axis": "rotate", "distance": -90.0, "speed": 12.0},
          {"name": "approach_door", "axis": "forward", "distance": 0.50, "speed": 0.08},
          {"name": "door_to_table_standoff", "axis": "forward", "distance": 1.20, "speed": 0.06, "narrow_passage": true}
        ],
        "dining_transition": [
          {"name": "shift_left_toward_leg2", "axis": "strafe", "distance": 0.70, "speed": 0.05},
          {"name": "approach_leg3_final_work_area", "axis": "forward", "distance": 1.40, "speed": 0.05},
          {"name": "face_stage34_work_area", "axis": "rotate", "distance": -90.0, "speed": 8.0}
        ],
        "table_leg_tracking": {
          "enabled": true,
          "note": "Enabled with the official TMRv0.2 static transform; the front LaserScan frame is not axis-aligned, so scan points are transformed by the configured +45 degree offset/sign and sensor origin. Narrow-door safety uses 5 cm nominal body-side clearance and the 0.16 m table standoff.",
          "front_lidar_frame_aligned_with_base": false,
          "front_lidar_transform_confirmed_from_official_urdf": true,
          "source": "Franka official TMRv0.2 URDF/Xacro",
          "sensor_origin_x_m": 0.3275,
          "sensor_origin_y_m": 0.2175,
          "scan_angle_offset_deg": 45.0,
          "scan_angle_sign": -1.0,
          "body_front_x_m": 0.40,
          "body_half_width_m": 0.29,
          "body_front_from_lidar_m": 0.0725,
          "body_to_leg_clearance_m": 0.16,
          "leg_separation_min_m": 0.30,
          "leg_separation_max_m": 1.40,
          "max_leg_depth_difference_m": 0.15,
          "max_leg_cluster_diameter_m": 0.16,
          "doorway_centering": {
            "enabled": true,
            "required_frames": 3,
            "attempts": 15,
            "observation_wait_seconds": 0.25,
            "maximum_range_spread_m": 0.03,
            "center_tolerance_m": 0.02,
            "max_strafe_step_m": 0.04,
            "note": "LiDAR-only relative centering before the narrow measured route. If no stable doorway side returns exist, the controller automatically continues with start_to_kitchen (Shanghai measured fallback); hard range/force stops still apply."
          }
        }
      },
      "gripper_uses_float": true,
      "base_command_type": "twist_stamped",
      "spine_command_type": "float32",
      "vision_3d_available": false,
      "obstacle_safety_required": true,
